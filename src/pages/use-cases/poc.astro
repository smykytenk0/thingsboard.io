		border: 1px solid var(--color-border-light);
		border-radius: 12px;
	}

	.poc-deliverable__number {
		display: block;
		font-size: $font-size-4xl;
		font-weight: $font-weight-medium;
		line-height: 1.2;
		color: var(--poc-number-color);
		margin-bottom: $spacing-3;
	}

	.poc-deliverable__title {
		@include card-title-sm;
		color: var(--color-text);
		margin: 0 0 $spacing-4;
	}

	.poc-deliverable__text {
		@include text-m;
		color: var(--color-text-secondary);
		margin: 0;
	}

	// ---- Shared section pieces (sections below the day-10 cards) ----
	.poc-section {
		padding-top: $spacing-20;

		@include media-down(md) {
			padding-top: $spacing-16;
		}
	}

	.poc-section-title--with-intro {
		margin-bottom: $spacing-5;
	}

	.poc-section-intro {
		@include text-m;
		color: var(--color-text-secondary);
		text-align: center;
		max-width: var(--intro-width, 684px);
		margin: 0 auto $spacing-10;
	}

	// Info note: outlined icon square + title + text on the light accent tint
	.poc-note {
		display: flex;
		align-items: center;
		gap: $spacing-5;
		margin-top: $spacing-6;
		padding: $spacing-6;
		background: linear-gradient(rgba(var(--color-primary-rgb), 0.05), rgba(var(--color-primary-rgb), 0.05)),
			var(--color-bg-surface);
		border: 1px solid var(--sl-color-accent);
		border-radius: 12px;
	}

	.poc-note__icon {
		display: flex;
		flex-shrink: 0;
		align-items: center;
		justify-content: center;
		width: 48px;
		height: 48px;
		color: var(--sl-color-accent);
		border: 1px solid currentColor;
		border-radius: $radius-md;
	}

	.poc-note__title {
		@include card-title-sm;
		color: var(--color-text);
		margin: 0 0 $spacing-3;
	}

	.poc-note__text {
		@include text-m;
		color: var(--color-text-secondary);
