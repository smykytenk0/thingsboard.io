---
import UseCaseLayout from '../../layouts/UseCaseLayout.astro';
import NButton from '../../components/Landing/NButton.astro';
import ImageComparison from '../../components/UseCase/ImageComparison.astro';
import SmartImage from '../../components/SmartImage.astro';
import ContactModal from '../../components/Services/ContactModal.astro';
import leadGlow from '~/assets/images/usecases/poc/custom-dev-lead-bg.svg';
import glowPurple from '~/assets/images/usecases/poc/audience-glow-purple.svg';
import glowBlue from '~/assets/images/usecases/poc/audience-glow-blue.svg';
import glowYellow from '~/assets/images/usecases/poc/audience-glow-yellow.svg';
import iconDeviceData from '~/assets/images/usecases/poc/audience-icon-device-data.svg';
import iconEquipment from '~/assets/images/usecases/poc/audience-icon-equipment.svg';
import iconProduct from '~/assets/images/usecases/poc/audience-icon-product.svg';
import iconBrief from '~/assets/images/usecases/poc/journey-icon-brief.svg';
import iconOutcome from '~/assets/images/usecases/poc/journey-icon-outcome.svg';
import iconCheck from '~/assets/images/usecases/poc/list-icon-check.svg';
import iconDot from '~/assets/images/usecases/poc/list-icon-dot.svg';
import iconInfo from '~/assets/images/usecases/poc/note-icon-info.svg';
import quoteOpen from '~/assets/images/usecases/poc/testimonial-quote-open.svg';
import quoteClose from '~/assets/images/usecases/poc/testimonial-quote-close.svg';

const title = 'A working IoT application in 10 business days — for a fixed price';
const description =
	'One complete use case, built end to end: real data from your device or system, a clear operational interface, and automatic alerts when something needs attention. Complete for the agreed use case. Expandable when you need more.';

const clientsDir = '/src/assets/images/usecases/poc/clients';
const clients = [
	{ name: 'Magenta Business', file: 'magenta-business.svg', width: 86, height: 25 },
	{ name: 'Super Bock Group', file: 'super-bock-group.svg', width: 79, height: 35 },
	{ name: 'Kalitec', file: 'kalitec.svg', width: 94, height: 25 },
	{ name: 'Suessco', file: 'suessco.svg', width: 119, height: 21 },
	{ name: 'OXI', file: 'oxi.svg', width: 57, height: 21 },
	{ name: 'IONA Tech', file: 'iona-tech-logo.svg', width: 83, height: 27 },
	{ name: 'ASG Tech', file: 'asg-tech.svg', width: 169, height: 31 },
];

const audience = [
	{
		label: 'You make devices or equipment',
		title: 'Turn device data into something people can use',
		text: 'Your hardware already produces the data. We turn it into a working application where customers or operators can see readings, review history, receive alerts and access the information they need.',
		glow: glowPurple,
		glowCorner: 'bottom-left',
		icon: iconDeviceData,
	},
	{
		label: 'You operate equipment or assets',
		title: 'See what is happening across your equipment',
		text: 'Bring the data from your machines, sites or assets into one application. See current conditions, spot problems, review what happened and give the right people access.',
		glow: glowBlue,
		glowCorner: 'bottom-right',
		icon: iconEquipment,
	},
	{
		label: 'You are building a connected product',
		title: 'Make the complete product experience real',
		text: 'You know what the product should let people see, know or do. We establish the data flow and build the application around that use case — so you can put a complete, working experience in front of customers or stakeholders.',
		glow: glowYellow,
		glowCorner: 'bottom-right',
		icon: iconProduct,
	},
];

const journeySteps = [
	{
		title: 'How to connect the data?',
		text: 'How does data get from the device or existing system into the application?',
	},
	{
		title: 'How to make it useful?',
		text: 'How should someone see the current state and what happened over time?',
	},
	{
		title: 'How to handle problems?',
		text: 'What should happen when a value crosses a limit or a device stops reporting?',
	},
	{
		title: 'How to give people access?',
		text: 'Who needs to see what — and what should they be able to do?',
	},
	{
		title: 'How to keep it running?',
		text: 'Where does it live, how is it managed and what does it cost to operate?',
	},
];

const timelineDays = Array.from({ length: 11 }, (_, day) => day);
const timeline = [
	{ task: 'Kickoff & scope', start: 0, end: 0 },
	{ task: 'Development environment', start: 1, end: 2 },
	{ task: 'Real data flowing', start: 3, end: 4 },
	{ task: 'Working interface', start: 5, end: 6 },
	{ task: 'Users & permissions', start: 7, end: 7 },
	{ task: 'Alerts, actions & reports', start: 8, end: 8 },
	{ task: 'Deployment & QA', start: 9, end: 9 },
	{ task: 'Handover', start: 10, end: 10 },
];

const deliverables = [
	{
		title: 'Your data flowing in',
		text: 'Your device, gateway, API or existing system connected, with readings normalized, stored and available to work with.',
	},
	{
		title: 'One live view of everything',
		text: 'A unified screen showing the current state across all your assets, with the numbers that matter to your operation on top.',
	},
	{
		title: 'Detail and history',
		text: 'Open any asset or device to see live values and how they behaved over time, so people can tell a spike from a trend.',
	},
	{
		title: 'Alerts that reach people',
		text: 'Limits your team can adjust from the interface, and in-app plus email notifications when something needs attention.',
	},
	{
		title: 'The right access with control permission',
		text: 'Roles so customers, operators and admins each see only what they should — plus controls to send a command back to the device.',
	},
	{
		title: 'Yours to run',
		text: 'Everything we build is transferred into your ownership. It runs in your own environment and it belongs to you.',
	},
];

const gettingStarted = [
	{
		title: 'A device or data source',
		text: 'A device, sensor, API or other accessible source of data.',
		glow: 'blue',
	},
	{
		title: 'One clear use case',
		text: 'What should someone be able to see, know or do when this is working?',
		glow: 'yellow',
	},
	{
		title: '30–60 minutes for kickoff',
		text: 'Bring the person who understands the product, equipment and users.',
		glow: 'purple',
	},
];

const priceHighlights = ['Fixed price', '10 business days', 'One complete use case'];
// Two independent columns, as in the design (items don't line up across columns)
const priceIncluded = [
	[
		{ text: 'A working application covering one complete use case' },
		{ text: 'Kickoff workshop with the scope locked in writing' },
		{ text: 'Direct line to the engineers building it, with progress you can see as it lands' },
	],
	[
		{ text: 'White-labeling: your colors, logo, and login screen', footnote: true },
		{ text: 'Validated / not-validated summary and documented limitations' },
		{ text: 'Handover of configs, rule chains, and dashboards' },
	],
];

const fitGood = [
	'You already have a device, equipment, API or accessible source of data.',
	'You can explain the one problem the application needs to solve',
	'You need a monitoring, customer-facing or operational application around that use case',
	'You want something complete now, with the option to expand later',
];
const fitOther = [
	'The hardware or communication protocol is still being designed.',
	'Several major workflows or integrations need to land together.',
	'You are planning a multi-system or enterprise-wide rollout.',
	'The outcome is bigger than one focused use case.',
];

const scopeStats = [
	{ value: '8x', text: 'faster than greenfield — an eight-month MVP pattern delivered in about one month' },
	{ value: '70%', text: 'of the interface built by configuration, not custom code' },
	{ value: '40-50%', text: 'of configuration reused across engagements' },
	{ value: '100+', text: 'client engagements behind this fixed scope' },
];

const quoteMarks = { open: quoteOpen, close: quoteClose };
const testimonialsDir = '/src/assets/images/usecases/poc/testimonials';
const testimonials = [
	{
		quote: 'The fixed-price, fast delivery approach worked perfectly for us.',
		name: 'Tamati Iro',
		role: 'VAS Manager',
		avatar: 'tamati-iro.svg',
		company: 'Vodafone',
		logo: 'vodafone.svg',
		logoWidth: 98,
		logoHeight: 25,
		mark: 'open',
	},
	{
		quote:
			'Working with the ThingsBoard team proved to be efficient, with just the right level of collaboration needed to deliver an optimal outcome.',
		name: 'Klemen Pevec',
		role: 'Head of Software Engineering',
		avatar: 'klemen-pevec.png',
		company: 'Awake',
		logo: 'awake.png',
		logoWidth: 127,
		logoHeight: 18,
		mark: 'close',
	},
] as const;

// Same case-study cards as the Development Services page. Each stat shows a short
// label that swaps to the long one (`long` lines) on hover.
const deliveredCases = [
	{
		slug: 'schwarz',
		tag: 'Retail & consumer service',
		title: 'IoT in retail: how Schwarz Group accelerated digitalization with ThingsBoard',
		image: 'schwarz.webp',
		logo: 'schwarz.svg',
		logoAlt: 'Schwarz logo',
		logoWidth: 410,
		logoHeight: 208,
		stats: [
			{ value: '500K+', short: 'Devices', long: ['Connected', 'devices'] },
			{ value: '13K+', short: 'Stores' },
			{ value: '32', short: 'Countries' },
		],
	},
	{
		slug: 'super-bock',
		tag: 'Manufacturing',
		title: 'Revolutionizing beer distribution: how ThingsBoard empowered Super Bock Group',
		image: 'super-bock-group.webp',
		logo: 'super-bock-group.svg',
		logoAlt: 'Super Bock Group logo',
		logoWidth: 126,
		logoHeight: 56,
		stats: [
			{ value: '100%', short: 'Visibility', long: ['Visibility of beer', 'stock in', 'real-time'] },
			{ value: '90%', short: 'Automation', long: ['Reduction in', 'manual', 'operations'] },
			{ value: '3+', short: 'Solutions', long: ['Integrated', 'solutions'] },
		],
	},
	{
		slug: 'dacor',
		tag: 'Industry 4.0',
		title: 'Real-time production monitoring for automotive supplier by süc//dacor GmbH',
		image: 'dacor.webp',
		logo: 'dacor.svg',
		logoAlt: 'Dacor logo',
		logoWidth: 400,
		logoHeight: 140,
		stats: [
			{ value: '20', short: 'Gateways', long: ['LoRaWAN', 'gateways in our', 'public network'] },
			{ value: '5+', short: 'IoT experience', long: ['Experience in the', 'field of IoT with', 'LoRaWAN'] },
			{ value: '150', short: 'Sensor types', long: ['Sensor types', 'tested in', 'our lab'] },
		],
	},
	{
		slug: 'oxi',
		tag: 'Energy and utilities',
		title: 'Empowering alternative energy: how OXI TRADE streamlined IoT infrastructure with TB',
		image: 'oxi.webp',
		logo: 'oxi.svg',
		logoAlt: 'OXI Trade logo',
		logoWidth: 153,
		logoHeight: 56,
		stats: [
			{ value: '10+', short: 'Experience', long: ['Years experience', 'in the alternative', 'energy sector'] },
			{ value: '7K', short: 'Sales', long: ['Pellet burners', 'sold'] },
			{ value: '96%', short: 'Efficiency', long: ['Efficiency of', 'pellet burners'] },
		],
	},
	{
		slug: 'awake',
		tag: 'Equipment tracking',
		title: 'Awake: unifying global rental operations with custom IoT solutions',
		image: 'awake.webp',
		logo: 'awake.svg',
		logoAlt: 'Awake logo',
		logoWidth: 402,
		logoHeight: 59,
		logoDisplayHeight: 20,
		stats: [
			{ value: '7', short: 'Experience', long: ['Years of', 'experience', 'on the market'] },
			{ value: '50+', short: 'Retailers', long: ['Retailers', 'managed under', 'one system'] },
			{ value: '6', short: 'Challenges', long: ['Solving', 'challenges', 'with data'] },
		],
	},
	{
		slug: 'senseing',
		tag: 'Logistic & supply-chain',
		title: 'Transforming food logistics with IoT-powered temperature monitoring',
		image: 'senseing.webp',
		logo: 'senseing.svg',
		logoAlt: 'SenseING GmbH logo',
		logoWidth: 240,
		logoHeight: 56,
		logoDisplayHeight: 24,
		stats: [
			{ value: '100%', short: 'Automation', long: ['Automated', 'temperature', 'monitoring'] },
			{ value: '90%', short: 'Accuracy', long: ['Reduction', 'in human error'] },
			{ value: '100+', short: 'Units', long: ['Storage and', 'transportation', 'units'] },
		],
	},
];
---

<UseCaseLayout title={title} description={description} pageSlug="poc">
	<section class="poc-hero">
		<div class="poc-hero__content">
			<h1 class="usecase-title poc-title">{title}</h1>
			<p class="poc-description">{description}</p>
			<NButton data-contact-modal-open class="poc-cta">Talk to an expert</NButton>
		</div>
		<div class="poc-hero__media">
			<img class="poc-hero__glow" src={leadGlow.src} alt="" aria-hidden="true" />
			<SmartImage
				class="poc-hero__lead"
				src="/src/assets/images/usecases/poc/head-of-delivery-quote.png"
				alt="Nizar Ali, Head of delivery: “You bring the product knowledge. We bring the IoT implementation experience.”"
				width={418}
				height={103}
				loading="eager"
			/>
		</div>
	</section>

	<ImageComparison
		class="poc-compare"
		baseImage="/src/assets/images/usecases/poc/poc-dashboard.png"
		baseImageAlt="ThingsBoard weather station dashboard with temperature, humidity, pressure and rainfall"
		width={1440}
		height={900}
	>
		<div slot="overlay" class="poc-compare__brief">
			<div class="poc-brief">
				<p class="poc-brief__subtitle">
					Day 0 — your brief in plain words → Day 10 — the working application
				</p>
				<p class="poc-brief__quote">
					“I need to monitor weather stations across the country in one place — see live
					temperature, humidity, pressure and rainfall, check the trends, and get an alert when
					rainfall exceeds the limit.”
				</p>
			</div>
		</div>
	</ImageComparison>

	<section class="poc-clients">
		<p class="poc-clients__caption">We created solutions for</p>
		<ul class="poc-clients__logos">
			{
				clients.map((client) => (
					<li>
						<SmartImage
							src={`${clientsDir}/${client.file}`}
							alt={`${client.name} logo`}
							width={client.width}
							height={client.height}
						/>
					</li>
				))
			}
		</ul>
		<p class="poc-clients__caption">And more than 200 companies too</p>
	</section>

	<section class="poc-audience">
		<h2 class="poc-section-title">Who is this proposal for?</h2>
		<div class="poc-audience__cards">
			{
				audience.map((card) => (
					<article class="poc-audience-card">
						<img
							class={`poc-audience-card__glow poc-audience-card__glow--${card.glowCorner}`}
							src={card.glow.src}
							alt=""
							aria-hidden="true"
						/>
						<div class="poc-audience-card__head">
							<p class="poc-audience-card__label">{card.label}</p>
							<img class="poc-audience-card__icon" src={card.icon.src} alt="" width="24" height="24" />
						</div>
						<h3 class="poc-audience-card__title">{card.title}</h3>
						<p class="poc-audience-card__text">{card.text}</p>
					</article>
				))
			}
		</div>
	</section>

	<section class="poc-journey">
		<h2 class="poc-section-title">A simple IoT use case turns into a software project</h2>
		<ol class="poc-journey__steps">
			<li class="poc-journey__step poc-journey__step--start">
				<span class="poc-journey__marker" aria-hidden="true">
					<img src={iconBrief.src} alt="" width="24" height="24" />
				</span>
				<div>
					<p class="poc-journey__note">
						I need to see these machines remotely, understand how they’re performing and know when
						something goes wrong.
					</p>
					<p class="poc-journey__lead">
						Between that sentence and the person who will actually use it, there is a whole path to
						work out:
					</p>
				</div>
			</li>
			{
				journeySteps.map((step) => (
					<li class="poc-journey__step poc-journey__step--question">
						<span class="poc-journey__marker" aria-hidden="true">
							?
						</span>
						<div>
							<h3 class="poc-journey__title">{step.title}</h3>
							<p class="poc-journey__text">{step.text}</p>
						</div>
					</li>
				))
			}
			<li class="poc-journey__step poc-journey__step--end">
				<span class="poc-journey__marker" aria-hidden="true">
					<img src={iconOutcome.src} alt="" width="15" height="17" />
				</span>
				<p class="poc-journey__note">What started as one clear outcome becomes a software project.</p>
			</li>
		</ol>
	</section>

	<section class="poc-schedule">
		<h2 class="poc-section-title">Ten business days, from kickoff to handover</h2>
		<p class="poc-schedule__intro">
			You bring the product knowledge. We bring the IoT implementation experience. We work through
			the key decisions together, in regular contact across the ten days.
		</p>
		<div class="poc-timeline">
			<table class="poc-timeline__table">
				<caption class="visually-hidden">Project plan by business day</caption>
				<thead>
					<tr>
						<th scope="col">Days</th>
						{timelineDays.map((day) => <th scope="col">{day}</th>)}
					</tr>
				</thead>
				<tbody>
					{
						timeline.map((row) => (
							<tr>
								<th scope="row">{row.task}</th>
								{timelineDays.map((day) => (
									<td>
										{day === row.start && (
											<span
												class="poc-timeline__bar"
												style={`--span: ${row.end - row.start + 1}`}
											>
												<span class="visually-hidden">
													{row.start === row.end ? `Day ${row.start}` : `Days ${row.start}–${row.end}`}
												</span>
											</span>
										)}
									</td>
								))}
							</tr>
						))
					}
				</tbody>
			</table>
		</div>
	</section>

	<section class="poc-deliverables">
		<h2 class="poc-section-title">What you get on day 10</h2>
		<p class="poc-deliverables__intro">
			One complete use case, working end to end — described by what it does for the people using
			it, not by a list of technical tasks.
		</p>
		<ol class="poc-deliverables__cards">
			{
				deliverables.map((item, i) => (
					<li class="poc-deliverable">
						<span class="poc-deliverable__number" aria-hidden="true">
							{String(i + 1).padStart(2, '0')}
						</span>
						<h3 class="poc-deliverable__title">{item.title}</h3>
						<p class="poc-deliverable__text">{item.text}</p>
					</li>
				))
			}
		</ol>
	</section>

	<section class="poc-cta-banner">
		<h2 class="poc-cta-banner__title">Not sure your use case fits?</h2>
		<p class="poc-cta-banner__text">
			Tell us what you need to get working. We will say plainly whether ten days is enough for it.
		</p>
		<NButton data-contact-modal-open class="poc-cta poc-cta--light">Talk to an expert</NButton>
	</section>

	<section class="poc-section">
		<h2 class="poc-section-title poc-section-title--with-intro">Three things to get started</h2>
		<p class="poc-section-intro" style="--intro-width: 640px">
			You don’t need to arrive with an IoT architecture or ThingsBoard specification. Bring what
			already exists and the outcome you want — we’ll work out the technical path together.
		</p>
		<ol class="poc-start__cards">
			{
				gettingStarted.map((item, i) => (
					<li class:list={['poc-start-card', `poc-start-card--${item.glow}`]}>
						<span class="poc-start-card__number" aria-hidden="true">
							{String(i + 1).padStart(2, '0')}
						</span>
						<h3 class="poc-start-card__title">{item.title}</h3>
						<p class="poc-start-card__text">{item.text}</p>
					</li>
				))
			}
		</ol>
		<aside class="poc-note">
			<span class="poc-note__icon" aria-hidden="true">
				<img src={iconInfo.src} alt="" width="20" height="20" />
			</span>
			<div>
				<h3 class="poc-note__title">No hardware available yet?</h3>
				<p class="poc-note__text">
					If the use case allows it, we can start with simulated data and connect the real device later.
				</p>
			</div>
		</aside>
	</section>

	<section class="poc-section">
		<h2 class="poc-section-title poc-section-title--with-intro">Fixed price, agreed before we start</h2>
		<p class="poc-section-intro">You approve the scope on day 0 and the price stops moving.</p>
		<div class="poc-price">
			<div class="poc-price__package">
				<p class="poc-price__label">Base package</p>
				<p class="poc-price__amount">$7000</p>
				<ul class="poc-price__highlights">
					{priceHighlights.map((item) => <li>{item}</li>)}
				</ul>
				<NButton data-contact-modal-open class="poc-cta poc-price__button" fullWidth>
					Talk to an expert
				</NButton>
			</div>
			<div class="poc-price__divider" aria-hidden="true"></div>
			<div class="poc-price__included">
				<h3 class="poc-price__heading">What’s included</h3>
				<div class="poc-price__lists">
					{
						priceIncluded.map((column) => (
							<ul class="poc-checklist poc-checklist--price">
								{column.map((item) => (
									<li>
										<img class="poc-checklist__icon" src={iconCheck.src} alt="" width="15" height="12" />
										<span>
											{item.text}
											{item.footnote && <span class="poc-price__star">*</span>}
										</span>
									</li>
								))}
							</ul>
						))
					}
				</div>
				<p class="poc-price__footnote">
					<span class="poc-price__star">*</span> White-labeling is configured inside the base sprint when
					your ThingsBoard license includes it. The price excludes your ThingsBoard subscription or license,
					hosting, hardware, and third-party services such as an SMS gateway.
				</p>
			</div>
		</div>
	</section>

	<section class="poc-section">
		<h2 class="poc-section-title poc-section-title--with-intro">Designed for one use case</h2>
		<p class="poc-section-intro" style="--intro-width: 672px">
			The 10-business-day package works best when there is one clear outcome to make real. For
			anything larger we scope it separately. If you already run ThingsBoard, your existing
			entities, integrations and dashboards are reused rather than rebuilt, so the same ten days
			reach further into your backlog.
		</p>
		<div class="poc-fit">
			<div class="poc-fit-card poc-fit-card--good">
				<h3 class="poc-fit-card__title">A good fit when</h3>
				<ul class="poc-checklist poc-checklist--fit">
					{
						fitGood.map((item) => (
							<li>
								<img class="poc-checklist__icon" src={iconCheck.src} alt="" width="15" height="12" />
								<span>{item}</span>
							</li>
						))
					}
				</ul>
			</div>
			<div class="poc-fit-card poc-fit-card--other">
