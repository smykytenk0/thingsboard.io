							<li>
								<img class="poc-dotlist__icon" src={iconDot.src} alt="" width="8" height="8" />
								<span>{item}</span>
							</li>
						))
					}
				</ul>
				<NButton data-contact-modal-open class="poc-cta poc-fit-card__button">Discover other options</NButton>
			</div>
		</div>
		<aside class="poc-note">
			<span class="poc-note__icon" aria-hidden="true">
				<img src={iconInfo.src} alt="" width="20" height="20" />
			</span>
			<div>
				<h3 class="poc-note__title">Note</h3>
				<p class="poc-note__text">
					Already running ThingsBoard? Existing entities, integrations, and dashboards are reused rather than rebuilt, so the same ten days reach further into your backlog.
				</p>
			</div>
		</aside>
	</section>

	<section class="poc-section">
		<h2 class="poc-section-title poc-scope__title">The scope comes from work already delivered</h2>
		<ul class="poc-scope">
			{
				scopeStats.map((stat) => (
					<li class="poc-stat">
						<p class="poc-stat__value">{stat.value}</p>
						<p class="poc-stat__text">{stat.text}</p>
					</li>
				))
			}
		</ul>
	</section>

	<section class="poc-testimonials">
		<h2 class="poc-testimonials__title">What clients say about working with us</h2>
		<div class="poc-testimonials__cards">
			{
				testimonials.map((item) => (
					<figure class:list={['poc-testimonial', `poc-testimonial--${item.mark}`]}>
						<img
							class="poc-testimonial__mark"
							src={quoteMarks[item.mark].src}
							alt=""
							width="80"
							height="65"
						/>
						<blockquote class="poc-testimonial__quote">
							<p>{item.quote}</p>
						</blockquote>
						<figcaption class="poc-testimonial__footer">
							<SmartImage
								class="poc-testimonial__avatar"
								src={`${testimonialsDir}/${item.avatar}`}
								alt={item.name}
								width={52}
								height={52}
							/>
							<span class="poc-testimonial__person">
								<span class="poc-testimonial__name">{item.name}</span>
								<span class="poc-testimonial__role">{item.role}</span>
							</span>
							<SmartImage
								class="poc-testimonial__logo"
								src={`${testimonialsDir}/${item.logo}`}
								alt={`${item.company} logo`}
								width={item.logoWidth}
								height={item.logoHeight}
							/>
						</figcaption>
					</figure>
				))
			}
		</div>
	</section>

	<section class="poc-cases">
		<h2 class="poc-cases__title">Where it has already been delivered</h2>
		<ul class="poc-cases__grid">
			{
				deliveredCases.map((item) => (
					<li class="poc-case">
						<a
							class="poc-case__link"
							href={`/case-studies/${item.slug}/`}
							style={`background-image: linear-gradient(0deg, rgba(0, 0, 0, 0.3) 0%, rgba(0, 0, 0, 0.3) 100%), url('/images/case-studies/${item.image}')`}
						>
							<span class="poc-case__content">
								<span class="poc-case__header">
									<span class="poc-case__tag">{item.tag}</span>
									<img
										class="poc-case__logo"
										src={`/images/case-studies/${item.logo}`}
										alt={item.logoAlt}
										width={item.logoWidth}
										height={item.logoHeight}
										style={item.logoDisplayHeight && `height: ${item.logoDisplayHeight}px`}
										loading="lazy"
									/>
								</span>
								<span class="poc-case__footer">
									<span class="poc-case__title">{item.title}</span>
									<span class="poc-case__stats">
										{item.stats.map((stat) => (
											<span class="poc-case__stat">
												<span class="poc-case__value">{stat.value}</span>
												<span class="poc-case__short">{stat.short}</span>
												<span class="poc-case__long">
													{(stat.long ?? [stat.short]).map((line, i) => (
														<>
															{i > 0 && <br />}
															{line}
														</>
													))}
												</span>
											</span>
										))}
									</span>
								</span>
							</span>
						</a>
					</li>
				))
			}
		</ul>
	</section>

	<section class="poc-workshop">
		<div class="poc-workshop__content">
			<p class="poc-workshop__badge">Next step</p>
			<h2 class="poc-workshop__title">A 30-minute technical workshop</h2>
			<p class="poc-workshop__text">
				Before anyone signs, we check that a fixed scope fits your use case. In 30 minutes we confirm
				the fit, walk through what you already have, and agree a kickoff date.
			</p>
			<NButton data-contact-modal-open class="poc-cta poc-cta--workshop">Talk to an expert</NButton>
		</div>
		<aside class="poc-contact" aria-label="Your contact">
			<p class="poc-contact__label">Talk to</p>
			<div class="poc-contact__person">
				<SmartImage
					class="poc-contact__avatar"
					src="/src/assets/images/usecases/poc/nizar-ali.png"
					alt="Nizar Ali"
					width={52}
					height={52}
				/>
				<div>
					<p class="poc-contact__name">Nizar Ali</p>
					<p class="poc-contact__role">ThingsBoard Custom Development Unit</p>
				</div>
			</div>
		</aside>
	</section>
	<ContactModal formId="poc_sales_modal" tags="sales" />
</UseCaseLayout>

<style lang="scss">
	@use '../../styles/variables' as *;

	.poc-title {
		max-width: 596px;
	}

	.poc-description {
		@include text-m;
		color: var(--color-text-secondary);
		max-width: 504px;
		margin: 0 0 $spacing-8;
	}

	// Text on the left, development-lead card on the right; stacks below lg,
	// where the 596px title and the 418px card no longer fit side by side
	.poc-hero {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: $spacing-6;
		margin-bottom: $spacing-12;

		@include media-down(lg) {
			flex-direction: column;
			align-items: flex-start;
		}
	}

	.poc-hero__media {
		position: relative;
		flex-shrink: 0;
		max-width: 100%;
	}

	// Decorative radial glow behind the card: right edge on the container border
	// (cancels the side padding), ellipse centre (y = 249 of 460) on the card's centre
	.poc-hero__glow {
		position: absolute;
		top: calc(50% - 249px);
		right: -$spacing-5;
		width: 550px;
		max-width: none;
		height: 460px;
		pointer-events: none;
		user-select: none;
	}

	.poc-hero__lead {
		position: relative;
		display: block;
		max-width: 100%;
		height: auto;
	}

	// Typography matches `button-base` (ui/button: 16px / 500 / 1.5); `font-family: inherit`
	// because a <button> doesn't inherit the site font and would otherwise fall back to Arial.
	.poc-cta {
		font-family: inherit;
		font-weight: $font-weight-medium;
		line-height: 1.5;
	}

	.poc-compare {
		margin: 0 0 $spacing-12;
	}

	// HTML side of the comparison; fills the whole slider area
	.poc-compare__brief {
		display: flex;
		align-items: center;
		width: 100%;
		height: 100%;
		background: var(--color-bg-light);
	}

	// Keeps the text in the left half, clear of the divider's starting position
	.poc-brief {
		max-width: 450px;
		margin-left: 35px;
	}

	.poc-brief__subtitle {
		@include section-badge;
		color: var(--sl-color-accent);
		margin: 0 0 $spacing-2;
	}

	.poc-brief__quote {
		@include card-title;
		color: var(--color-text);
		margin: 0;
	}

	.poc-clients__caption {
		@include text-table-cell;
		color: var(--color-text-secondary);
		text-align: center;
		margin: 0;
	}

	// One row, equal space between logos; wraps (centered) once they no longer fit
	.poc-clients__logos {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: $spacing-6;
		margin: $spacing-8 0 $spacing-5;
		padding: 0;
		list-style: none;

		li {
			display: flex;
		}

		@include media-down(md) {
			justify-content: center;
		}
	}

	.poc-audience {
		padding-top: $spacing-30;

		@include media-down(md) {
			padding-top: $spacing-16;
		}
	}

	.poc-section-title {
		@include section-title;
		color: var(--color-text);
		text-align: center;
		margin: 0 0 $spacing-12;

		@include media-down(md) {
			margin-bottom: $spacing-8;
		}
	}

	.poc-audience__cards {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: $spacing-6;

		@include media-down(lg) {
			grid-template-columns: repeat(2, 1fr);
		}

		@include media-down(md) {
			grid-template-columns: 1fr;
		}
	}

	.poc-audience-card {
		position: relative;
		overflow: clip;
		padding: $spacing-5;
		background: var(--color-bg-surface);
		border: 1px solid var(--color-border);
		border-radius: 12px;
	}

	// Card hover — same lift + shadow as the Device Library / Partners cards
	.poc-audience-card,
	.poc-deliverable,
	.poc-start-card,
	.poc-fit-card,
	.poc-testimonial {
		transition:
			transform 0.2s,
			box-shadow 0.2s;

		&:hover {
			transform: translateY(-2px);
			box-shadow: var(--shadow-card-hover, 0 4px 12px rgba(0, 0, 0, 0.15));
		}

		@media (prefers-reduced-motion: reduce) {
			transition: box-shadow 0.2s;

			&:hover {
				transform: none;
			}
		}
	}

	// Decorative corner glow (Figma export, cropped to the top-right corner and
	// flipped into the bottom corner); the card's overflow clip + radius trims it
	.poc-audience-card__glow {
		position: absolute;
		bottom: 0;
		pointer-events: none;
		user-select: none;

		&--bottom-right {
			right: 0;
			transform: scaleY(-1);
		}

		&--bottom-left {
			left: 0;
			transform: scale(-1, -1);
		}
	}

	// Content paints above the glow
	.poc-audience-card > :not(.poc-audience-card__glow) {
		position: relative;
	}

	// Who-it's-for label on the left, icon on the right
	.poc-audience-card__head {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: $spacing-4;
		margin-bottom: $spacing-4;
	}

	.poc-audience-card__label {
		@include text-s;
		font-weight: $font-weight-medium;
		color: var(--sl-color-accent);
		margin: 0;
	}

	.poc-audience-card__icon {
		flex-shrink: 0;
		width: 24px;
		height: 24px;
	}

	.poc-audience-card__title {
		@include card-title-sm;
		color: var(--color-text);
		margin: 0 0 $spacing-4;
	}

	.poc-audience-card__text {
		@include text-card;
		color: var(--color-text-secondary);
		margin: 0;
	}
	.poc-journey {
		// Colours from the design with no site token yet; dark variants keep contrast
		--poc-question-bg: #fff5e6;
		--poc-question-border: #f19102;
		--poc-outcome-bg: #ebfaf1;

		padding-top: $spacing-30;

		@include media-down(md) {
			padding-top: $spacing-16;
		}

		.poc-section-title {
			margin-bottom: $spacing-8;
		}
	}

	// Vertical timeline: 44px markers joined by a line through their centres
	.poc-journey__steps {
		display: flex;
		flex-direction: column;
		gap: $spacing-6;
		max-width: 684px;
		margin: 0 auto;
		padding: 0;
		list-style: none;
	}

	.poc-journey__step {
		position: relative;
		display: grid;
		grid-template-columns: 44px minmax(0, 1fr);
		column-gap: $spacing-6;
		align-items: start;
		margin: 0;

		@include media-down(md) {
			column-gap: $spacing-4;
		}

		// Connector: from just below this marker to just above the next one (4px gap at each end),
		// so it never touches the markers or runs past the last one when text wraps
		&:not(:last-child)::after {
			content: '';
			position: absolute;
			top: calc(44px + #{$spacing-1});
			bottom: calc(-1 * #{$spacing-6} + #{$spacing-1});
			left: 21.5px;
			width: 1px;
			background: var(--color-border);
		}
	}

	.poc-journey__marker {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 44px;
		height: 44px;
		font-size: $font-size-base;
		line-height: 24px;
		color: var(--color-text);
		background: var(--color-bg-surface);
		border: 1px solid var(--color-border);
		border-radius: $radius-lg;
	}

	.poc-journey__title {
		font-size: $font-size-base;
		font-weight: $font-weight-medium;
		line-height: 24px;
		color: var(--color-text);
		margin: 0 0 $spacing-1;
	}

	.poc-journey__text {
		@include text-m;
		color: var(--color-text-secondary);
		margin: 0;
	}

	.poc-journey__lead {
		font-size: $font-size-lg;
		font-weight: $font-weight-medium;
		line-height: 24px;
		color: var(--color-text);
		max-width: 551px;
		margin: $spacing-4 0 $spacing-2;
	}

	.poc-journey__note {
		@include text-m;
		max-width: 551px;
		margin: 0;
		padding: $spacing-2 $spacing-4;
		border: 1px solid;
		border-radius: $radius-lg;
	}

	// Start: the brief (accent) — tint layered over the surface colour
	.poc-journey__step--start {
		.poc-journey__marker,
		.poc-journey__note {
			border-color: var(--sl-color-accent);
			background: linear-gradient(rgba(var(--color-primary-rgb), 0.05), rgba(var(--color-primary-rgb), 0.05)),
				var(--color-bg-surface);
		}

		.poc-journey__marker {
			color: var(--sl-color-accent);
		}
	}

	// Open questions: dark "?" on light yellow with an orange outline
	.poc-journey__step--question .poc-journey__marker {
		border-color: var(--poc-question-border);
		background: var(--poc-question-bg);
	}

	// Extra space before the outcome; padding (not margin) so the connector still reaches it
	.poc-journey__step--question:has(+ .poc-journey__step--end) {
		padding-bottom: $spacing-2;
	}

	// End: the outcome (green)
	.poc-journey__step--end {
		.poc-journey__marker,
		.poc-journey__note {
			border-color: var(--color-success);
			background: var(--poc-outcome-bg);
		}

		.poc-journey__marker {
			color: var(--color-success);
		}
	}

	.poc-schedule {
		padding-top: $spacing-20;

		@include media-down(md) {
			padding-top: $spacing-16;
		}

		.poc-section-title {
			margin-bottom: $spacing-5;
		}
	}

	.poc-schedule__intro {
		@include text-m;
		color: var(--color-text-secondary);
		text-align: center;
		max-width: 684px;
		margin: 0 auto $spacing-10;
	}

	// Scrolls sideways on narrow screens instead of squashing the 11 day columns
	.poc-timeline {
		--poc-timeline-bg: linear-gradient(rgba(var(--color-primary-rgb), 0.05), rgba(var(--color-primary-rgb), 0.05)),
			var(--color-bg-surface);

		overflow-x: auto;
		background: var(--poc-timeline-bg);
		border-radius: 12px;
	}

	.poc-timeline__table {
		width: 100%;
		min-width: 760px;
		table-layout: fixed;
		border-collapse: collapse;
		@include text-table-cell;
		color: var(--color-text-secondary);

		th {
			font-weight: $font-weight-normal;
		}

		// Task label column; stays in place while the days scroll underneath on narrow screens
		th:first-child {
			position: sticky;
			left: 0;
			z-index: 1;
			width: 227px;
			padding: 0 $spacing-4 0 0;
			text-align: right;
			white-space: nowrap;
			background: var(--poc-timeline-bg);
		}

		thead th {
			height: 36px;
			padding-top: 0;
			padding-bottom: 0;
			border-bottom: 1px solid var(--color-border-light);
		}

		thead th:not(:first-child) {
			text-align: center;
		}

		tbody th,
		tbody td {
			height: 40px;
			padding-top: 0;
			padding-bottom: 0;
		}

		// Column lines between the label column and every day
		tbody td {
			position: relative;
			padding: 0;
			border-left: 1px solid var(--color-border-light);
		}

		// Breathing room above the first and below the last task
		tbody tr:first-child > * {
			height: 60px;
			padding-top: $spacing-5;
		}

		tbody tr:last-child > * {
			height: 52px;
			padding-bottom: $spacing-3;
		}

		// Keep those two rows' bars centred on the 40px row, not the padded cell
		tbody tr:first-child .poc-timeline__bar {
			top: calc(50% + #{$spacing-5} / 2);
		}

		tbody tr:last-child .poc-timeline__bar {
			top: calc(50% - #{$spacing-3} / 2);
		}
	}

	// Soft bar across the task's days: transparent at the ends, strongest in the middle.
	// Sits in the first day's cell and stretches over `--span` columns (plus their 1px lines).
	.poc-timeline__bar {
		position: absolute;
		top: 50%;
		left: 2px;
		width: calc(var(--span) * 100% + (var(--span) - 1) * 1px - 4px);
		height: 22px;
		transform: translateY(-50%);
		background: linear-gradient(
			90deg,
			rgba(var(--color-primary-rgb), 0) 0%,
			rgba(var(--color-primary-rgb), 0.24) 50%,
			rgba(var(--color-primary-rgb), 0) 100%
		);
	}

	.poc-deliverables {
		--poc-number-color: #b3c7ff; // from the design; no site token has this exact value

		padding-top: $spacing-20;

		@include media-down(md) {
			padding-top: $spacing-16;
		}

		.poc-section-title {
			margin-bottom: $spacing-5;
		}
	}

	.poc-deliverables__intro {
